# --- Browser (Vite) ---
# WebSocket URL of the shared-lake server. Leave unset in production to ship solo-only
# (in `npm run dev` it defaults to ws://<host>:8787). Use wss:// when the site is served over https.
VITE_REALTIME_URL=ws://localhost:8787

# --- Server (npm run server) ---
PORT=8787
# Comma-separated list of page origins allowed to connect. Empty = any origin (development only).
ALLOWED_ORIGINS=http://localhost:5173
# Set to 1 only behind exactly one trusted reverse proxy (Render, nginx…) so the per-IP limit reads X-Forwarded-For.
TRUST_PROXY=0
